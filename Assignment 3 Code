<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>College Fest | Event Portal</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #101010;
        color: #f5f5f5;
    }

    header {
        background: #181818;
        padding: 20px;
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        border-bottom: 2px solid #333;
    }

    nav {
        display: flex;
        justify-content: center;
        gap: 20px;
        background: #1e1e1e;
        padding: 12px;
        border-bottom: 2px solid #333;
    }

    nav a {
        color: #f5f5f5;
        text-decoration: none;
        font-weight: bold;
    }

    section {
        padding: 30px;
        display: none;
    }

    h2 {
        color: #ffcc00;
    }

    /* Events list */
    ul {
        font-size: 18px;
        line-height: 1.8;
    }

    /* Schedule Table */
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }
    th, td {
        border: 1px solid #444;
        padding: 12px;
        text-align: center;
    }
    th {
        background: #222;
        color: #ffcc00;
    }

    /* Form */
    input, select, textarea {
        width: 100%;
        padding: 12px;
        margin: 10px 0;
        background: #222;
        border: 1px solid #444;
        color: white;
        border-radius: 4px;
    }
    button {
        padding: 12px 20px;
        background: #ffcc00;
        border: none;
        color: black;
        font-weight: bold;
        cursor: pointer;
        border-radius: 4px;
    }

    /* Gallery */
    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }
    .gallery img {
        width: 100%;
        border-radius: 10px;
        border: 2px solid #333;
    }

    footer {
        margin-top: 40px;
        text-align: center;
        padding: 15px;
        background: #181818;
        border-top: 2px solid #333;
    }
</style>
</head>

<body>

<header>COLLEGE FEST 2025</header>

<nav>
    <a href="#" onclick="showPage('home')">Home</a>
    <a href="#" onclick="showPage('events')">Events</a>
    <a href="#" onclick="showPage('schedule')">Schedule</a>
    <a href="#" onclick="showPage('register')">Register</a>
    <a href="#" onclick="showPage('gallery')">Gallery</a>
    <a href="#" onclick="showPage('contact')">Contact & FAQs</a>
</nav>

<!-- HOME -->
<section id="home">
    <h2>Welcome to College Fest 2025</h2>
    <p>Date: <b>15 - 17 March 2025</b></p>
    <p>The annual college fest featuring music, dance, coding, gaming, arts, sports, and much more!</p>

    <h3>Follow Us :</h3>
    <ul>
        <li><a href="#" style="color:#ffcc00;">Instagram</a></li>
        <li><a href="#" style="color:#ffcc00;">Facebook</a></li>
        <li><a href="#" style="color:#ffcc00;">YouTube</a></li>
    </ul>
</section>

<!-- EVENTS -->
<section id="events">
    <h2>Events & Competitions</h2>
    <ul>
        <li>Solo Dance Competition</li>
        <li>Battle of Bands</li>
        <li>Hackathon – 24 Hour Coding Event</li>
        <li>Esports Tournament (BGMI, Valorant)</li>
        <li>Art & Poster Making</li>
        <li>Sports Events – Football, Cricket, Badminton</li>
    </ul>
</section>

<!-- SCHEDULE -->
<section id="schedule">
    <h2>Event Schedule</h2>

    <table>
        <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Time</th>
        </tr>
        <tr>
            <td>Hackathon</td>
            <td>15 March</td>
            <td>9:00 AM</td>
        </tr>
        <tr>
            <td>Dance Competition</td>
            <td>16 March</td>
            <td>2:00 PM</td>
        </tr>
        <tr>
            <td>Football Finals</td>
            <td>17 March</td>
            <td>4:00 PM</td>
        </tr>
    </table>
</section>

<!-- REGISTRATION -->
<section id="register">
    <h2>Registration Form</h2>

    <form onsubmit="submitForm(); return false;">
        <label>Name</label>
        <input type="text" required>

        <label>Email</label>
        <input type="email" required>

        <label>Select Event</label>
        <select>
            <option>Hackathon</option>
            <option>Dance</option>
            <option>Esports</option>
            <option>Art</option>
        </select>

        <label>Message / Team Details</label>
        <textarea rows="4"></textarea>

        <button type="submit">Submit</button>
    </form>
</section>

<!-- GALLERY -->
<section id="gallery">
    <h2>Photo Gallery</h2>
    <div class="gallery">
        <img src="https://picsum.photos/300/200?1">
        <img src="https://picsum.photos/300/200?2">
        <img src="https://picsum.photos/300/200?3">
        <img src="https://picsum.photos/300/200?4">
        <img src="https://picsum.photos/300/200?5">
        <img src="https://picsum.photos/300/200?6">
    </div>
</section>

<!-- CONTACT -->
<section id="contact">
    <h2>Contact Us</h2>
    <p>Email: <b>collegefest2025@gmail.com</b></p>
    <p>Phone: <b>+91 9876543210</b></p>

    <h3>FAQs</h3>
    <ul>
        <li><b>How to register?</b> — Use the Registration page.</li>
        <li><b>Is the fest open for outsiders?</b> — Only for registered participants.</li>
        <li><b>Do events have entry fees?</b> — Some events are free, some paid.</li>
    </ul>
</section>

<footer>
    © 2025 College Fest. All Rights Reserved.
</footer>

<script>
    function showPage(id) {
        document.querySelectorAll("section").forEach(sec => sec.style.display = "none");
        document.getElementById(id).style.display = "block";
    }
    showPage('home'); // default open page

    function submitForm() {
        alert("Registration Submitted Successfully!");
    }
</script>

</body>
</html>
