// Sort in ascending order using Selection Sort
let ascending = [...numbers];
for (let i = 0; i < ascending.length - 1; i++) {
 let minIndex = i;
 for (let j = i + 1; j < ascending.length; j++) {
 if (ascending[j] < ascending[minIndex]) {
 minIndex = j;
 }
 }
 // Swap
 let temp = ascending[i];
 ascending[i] = ascending[minIndex];
 ascending[minIndex] = temp;
}
console.log("Ascending Order:", ascending);
// Sort in descending order using Selection Sort
let descending = [...numbers];
for (let i = 0; i < descending.length - 1; i++) {
 let maxIndex = i;
 for (let j = i + 1; j < descending.length; j++) {
 if (descending[j] > descending[maxIndex]) {
 maxIndex = j;
 }
 }
 // Swap
 let temp = descending[i];
 descending[i] = descending[maxIndex];
 descending[maxIndex] = temp;
}
