 <section>
 <h2>Participant Registration Form</h2>
 <form>
 <label for="name">Full Name</label>
 <input id="name" name="name" type="text" required placeholder="e.g., A.
Sharma">
 <label for="branch">Branch</label>
 <input id="branch" name="branch" type="text" required placeholder="e.g.,
ECE">
 <p style="margin-top:6px;"><strong>Select Sports (multiple
allowed):</strong></p>
 <div role="group" aria-label="Sports selection">
 <label><input type="checkbox" name="sports"
value="Football">Football</label>
 <label><input type="checkbox" name="sports"
value="Basketball">Basketball</label>
 <label><input type="checkbox" name="sports" value="Table Tennis">Table
Tennis</label>
 <label><input type="checkbox" name="sports"
value="Badminton">Badminton</label>
 <label><input type="checkbox" name="sports" value="Lawn Tennis">Lawn
Tennis</label>
 <label><input type="checkbox" name="sports" value="Track & Field">Track
&amp; Field</label>
 <label><input type="checkbox" name="sports"
value="Cricket">Cricket</label>
 </div>
 <input type="submit" value="Submit Registration">
 </form>
 </section>
